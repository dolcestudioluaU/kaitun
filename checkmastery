local player = game.Players.LocalPlayer
local replicated = game:GetService("ReplicatedStorage")

local function getMastery(weaponName)
    local success, inventory = pcall(function()
        return replicated.Remotes.CommF_:InvokeServer("getInventory")
    end)
    
    if not success or not inventory then
        return -1
    end
    
    for _, item in pairs(inventory) do
        if type(item) == "table" and item.Name == weaponName then
            return item.Mastery or 0
        end
    end
    return -1
end

local function getWeaponType(tool)
    if not tool then return nil end
    local tip = tool.ToolTip
    if tip == "Melee" then return "Melee"
    elseif tip == "Sword" then return "Sword"
    elseif tip == "Gun" then return "Gun"
    elseif tip == "Blox Fruit" then return "Blox Fruit"
    end
    return nil
end

local function checkMastery()
    local char = player.Character
    if not char then
        print("Error 101")
        return
    end
    
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then
        print("Error 102")
        return
    end
    
    local weaponType = getWeaponType(tool)
    if not weaponType then
        print("Error 103")
        return
    end
    
    local mastery = getMastery(tool.Name)
    if mastery == -1 then
        print("Error 104")
        return
    end
    
    print(string.format("Yor weapon | %s | Mastery Weapon : %d", tool.Name, mastery))
end

checkMastery()

game:GetService("UserInputService").InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.F5 then
        checkMastery()
    end
end)
